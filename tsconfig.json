{
	"compilerOptions": {
		"lib": ["es6"],
		"allowJs": true,
		"outDir": "build",
		"rootDir": "src",
		"strict": true,
		"noImplicitAny": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"paths": {
			"@/*": ["./src/*"]
		},
	},
	"include": ["lib/**/*.ts", "src/**/*"],
	"exclude": ["node_modules"],
	"files": ["express.d.ts"]
}
