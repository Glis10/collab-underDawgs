enum service_status {
  available
  assigned
  off_duty
}

enum request_status {
  pending
  assigned
  rejected
  in_progress
}

enum role {
  admin
  user
}

enum status_update {
  accepted
  arrived
  on_route
  rejected
}

enum org_status {
  not_active
  active
  not_verified
}

enum priority {
  low
  medium
  high
}

table service_provider {
  id uuid [pk, not null, unique, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  age integer [not null]
  email varchar(255) [not null, unique]
  phone_number bigint [not null, unique]
  primary_address varchar(255) [not null]
  password varchar(255) [not null]
  service_type service_type [not null]
  is_verified boolean [default: false]
  profile_picture varchar(255)
  organization_id uuid [not null]
  current_location json [default: `{"latitude":"","longitude":""}`]
  service_status service_status [not null, default: 'available']
  verification_token varchar(255)
  token_expiry timestamp
  reset_password_token varchar(255)
  reset_password_token_expiry timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table emergency_request {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  service_type service_type [not null]
  request_status request_status [not null, default: 'pending']
  request_time timestamp [default: `now()`]
  dispatch_time timestamp
  arrival_time timestamp
  description varchar(255)
  location json [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table user {
  id uuid [pk, not null, unique, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  age integer [not null]
  phone_number bigint [not null, unique]
  email varchar(255) [not null, unique]
  primary_address varchar(255) [not null]
  password varchar(255) [not null]
  is_verified boolean [default: false]
  role role [default: 'user']
  profile_picture varchar(255)
  verification_token varchar(255)
  token_expiry timestamp
  current_location json [default: `{"latitude":"","longitude":""}`]
  reset_password_token varchar(255)
  reset_password_token_expiry timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table emergency_response {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  emergency_request_id uuid
  service_provider_id uuid
  status_update status_update [default: 'accepted']
  origin_location json [not null]
  destination_location json [not null]
  assigned_at timestamp
  responded_at timestamp [default: `now()`]
  updateDescription varchar(255)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table organization {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name varchar(255) [not null, unique]
  service_category service_type [not null]
  general_number bigint [not null]
  org_status org_status [not null, default: 'not_verified']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table emergency_contact {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name varchar(50) [not null]
  is_comman_contact boolean [not null, default: false]
  relationship varchar(50) [not null]
  phone_number varchar(15) [not null]
  user_id uuid
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table feedback {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  serviceProvider_id uuid [not null]
  message varchar(510)
  service_ratings integer
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table notification {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid
  service_provider_id uuid
  message varchar(255) [not null]
  type varchar(50) [not null]
  priority priority [default: 'low']
  source varchar(100) [not null]
  metadata json
  deliveryStatus varchar(50) [default: 'pending']
  is_read boolean [default: false]
  do_not_disturb boolean [default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

ref: service_provider.organization_id > organization.id

ref: emergency_request.user_id > user.id

ref: emergency_response.emergency_request_id - emergency_request.id

ref: emergency_response.service_provider_id - service_provider.id

ref: emergency_contact.user_id - user.id

ref: feedback.user_id > user.id

ref: feedback.serviceProvider_id > service_provider.id

ref: notification.user_id - user.id

ref: notification.service_provider_id - service_provider.id